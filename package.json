{
  "name": "silvergrain-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "离线胶片资料库",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "desktop": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "~5.6.3",
    "vite": "^8.3.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.silvergrain.library",
    "productName": "银盐图书馆",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "film-library/brands",
        "to": "film-library/brands",
        "filter": ["**/*.pdf"]
      },
      {
        "from": "film-library/equipment",
        "to": "film-library/equipment",
        "filter": ["**/*.pdf"]
      },
      {
        "from": "film-library/industry",
        "to": "film-library/industry",
        "filter": ["**/*.pdf"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/silvergrain-app.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
